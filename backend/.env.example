# Local PostgreSQL example. For Supabase, use its Session pooler connection
# string (port 5432) and include ?sslmode=require.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/doppelganger
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doppelganger
CORS_ORIGINS=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
